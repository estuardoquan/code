UNIFI_CONSOLE_PUID=1000
UNIFI_CONSOLE_PGID=1000
UNIFI_CONSOLE_TZ=Etc/UTC
UNIFI_CONSOLE_MONGO_USER=unifi
UNIFI_CONSOLE_MONGO_PASS=secret
UNIFI_CONSOLE_MONGO_HOST=db
UNIFI_CONSOLE_MONGO_PORT=27017
UNIFI_CONSOLE_MONGO_DBNAME=unifi
UNIFI_CONSOLE_MONGO_AUTHSOURCE=admin
UNIFI_CONSOLE_MEM_LIMIT=1024
UNIFI_CONSOLE_MEM_STARTUP=1024
UNIFI_CONSOLE_MONGO_TLS=

UNIFI_MONGO_INITDB_ROOT_USERNAME=root
UNIFI_MONGO_INITDB_ROOT_PASSWORD=password
UNIFI_MONGO_USER=${CONSOLE_MONGO_USER}
UNIFI_MONGO_PASS=${CONSOLE_MONGO_PASS}
UNIFI_MONGO_DBNAME=${CONSOLE_MONGO_DBNAME}
UNIFI_MONGO_AUTHSOURCE=${CONSOLE_MONGO_AUTHSOURCE}

TEMPLATE_DIR=../../templates
TEMPLATE_UNIFI_CONSOLE=${TEMPLATE_DIR}/unifi/console.yaml
TEMPLATE_UNIFI_MONGO=${TEMPLATE_DIR}/unifi/mongo.yaml


